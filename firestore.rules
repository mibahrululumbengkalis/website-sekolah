rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Guru/pegawai: punya dokumen pegawai/{uid} dan berstatus aktif
    function isPegawai() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/pegawai/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/pegawai/$(request.auth.uid)).data.aktif == true;
    }
    function strOk(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function strOpt(v, max) { return v is string && v.size() <= max; }

    // Tanggal hari ini menurut server, zona WIB (UTC+7), format YYYY-MM-DD
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function wibToday() {
      return string((request.time + duration.time(7, 0, 0, 0)).year()) + '-' +
             pad2((request.time + duration.time(7, 0, 0, 0)).month()) + '-' +
             pad2((request.time + duration.time(7, 0, 0, 0)).day());
    }
    // Bagian posisi pada presensi (waktu wajib waktu server)
    function validPos(m) {
      return m.keys().hasOnly(['waktu', 'lat', 'lng', 'akurasi', 'jarak'])
        && m.waktu == request.time
        && m.lat is number && m.lng is number && m.akurasi is number && m.jarak is number;
    }

    // Daftar admin: dibuat manual lewat Firebase Console (dokumen id = UID akun admin)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Konten publik: semua orang boleh membaca, hanya admin yang boleh menulis
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /berita/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /slider/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /pengumuman/{id} { allow read: if true; allow write: if isAdmin(); }
    match /guru/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /galeri/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /fasilitas/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /program/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Pesan kontak: pengunjung hanya boleh membuat; admin yang membaca/mengelola
    match /pesan/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nama','email','telp','subjek','pesan','dibaca','createdAt'])
        && strOpt(request.resource.data.get('telp', ''), 30)
        && strOpt(request.resource.data.get('subjek', ''), 150)
        && strOk(request.resource.data.nama, 100)
        && strOpt(request.resource.data.email, 120)
        && strOk(request.resource.data.pesan, 1500)
        && request.resource.data.dibaca == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Pendaftar PPDB: pengunjung hanya boleh membuat; admin yang membaca/mengelola
    match /ppdb/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['namaAnak','tempatLahir','tglLahir','jk','namaOrtu','hp','alamat','asalSekolah','catatan','status','createdAt'])
        && request.resource.data.keys().hasAll(
          ['namaAnak','tempatLahir','tglLahir','jk','namaOrtu','hp','alamat','asalSekolah','catatan','status','createdAt'])
        && strOk(request.resource.data.namaAnak, 100)
        && strOk(request.resource.data.tempatLahir, 60)
        && strOk(request.resource.data.tglLahir, 20)
        && request.resource.data.jk in ['Laki-laki','Perempuan']
        && strOk(request.resource.data.namaOrtu, 100)
        && strOk(request.resource.data.hp, 20)
        && strOk(request.resource.data.alamat, 300)
        && strOpt(request.resource.data.asalSekolah, 100)
        && strOpt(request.resource.data.catatan, 500)
        && request.resource.data.status == 'baru'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Akun presensi guru: admin mengelola; guru hanya membaca dokumennya sendiri
    match /pegawai/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Presensi: id dokumen = {uid}_{YYYY-MM-DD}
    match /presensi/{id} {
      allow get: if isAdmin() || (request.auth != null && id.matches(request.auth.uid + '_.*'));
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);

      // Presensi masuk atau pengajuan izin/sakit/dinas: hanya untuk hari ini (WIB), sekali per hari
      allow create: if isAdmin() || (isPegawai()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.tanggal
        && request.resource.data.tanggal == wibToday()
        && request.resource.data.nama == get(/databases/$(database)/documents/pegawai/$(request.auth.uid)).data.nama
        && (
          (request.resource.data.status == 'hadir'
            && request.resource.data.keys().hasOnly(['uid','nama','tanggal','status','masuk'])
            && validPos(request.resource.data.masuk))
          ||
          (request.resource.data.status in ['izin','sakit','dinas']
            && request.resource.data.keys().hasOnly(['uid','nama','tanggal','status','ket'])
            && strOk(request.resource.data.ket, 300))
        ));

      // Presensi pulang: hanya menambah field "pulang" pada catatan hadir hari ini
      allow update: if isAdmin() || (isPegawai()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'hadir'
        && !('pulang' in resource.data)
        && resource.data.tanggal == wibToday()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pulang'])
        && validPos(request.resource.data.pulang));

      allow delete: if isAdmin();
    }

    // Foto selfie presensi: guru hanya boleh membuat (tidak bisa membaca/mengubah); admin membaca/menghapus
    match /presensi_foto/{id} {
      allow create: if isPegawai()
        && request.resource.data.keys().hasOnly(['uid','tanggal','jenis','foto','waktu'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.jenis in ['masuk','pulang']
        && request.resource.data.tanggal == wibToday()
        && id == request.auth.uid + '_' + request.resource.data.tanggal + '_' + request.resource.data.jenis
        && request.resource.data.waktu == request.time
        && strOk(request.resource.data.foto, 120000);
      allow read, update, delete: if isAdmin();
    }
  }
}
