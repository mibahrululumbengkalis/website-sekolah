rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function strOk(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function strOpt(v, max) { return v is string && v.size() <= max; }

    // Daftar admin: dibuat manual lewat Firebase Console (dokumen id = UID akun admin)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Konten publik: semua orang boleh membaca, hanya admin yang boleh menulis
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /pengumuman/{id} { allow read: if true; allow write: if isAdmin(); }
    match /guru/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /galeri/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /fasilitas/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /program/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Pesan kontak: pengunjung hanya boleh membuat; admin yang membaca/mengelola
    match /pesan/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nama','email','pesan','dibaca','createdAt'])
        && strOk(request.resource.data.nama, 100)
        && strOpt(request.resource.data.email, 120)
        && strOk(request.resource.data.pesan, 1500)
        && request.resource.data.dibaca == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Pendaftar PPDB: pengunjung hanya boleh membuat; admin yang membaca/mengelola
    match /ppdb/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['namaAnak','tempatLahir','tglLahir','jk','namaOrtu','hp','alamat','asalSekolah','catatan','status','createdAt'])
        && request.resource.data.keys().hasAll(
          ['namaAnak','tempatLahir','tglLahir','jk','namaOrtu','hp','alamat','asalSekolah','catatan','status','createdAt'])
        && strOk(request.resource.data.namaAnak, 100)
        && strOk(request.resource.data.tempatLahir, 60)
        && strOk(request.resource.data.tglLahir, 20)
        && request.resource.data.jk in ['Laki-laki','Perempuan']
        && strOk(request.resource.data.namaOrtu, 100)
        && strOk(request.resource.data.hp, 20)
        && strOk(request.resource.data.alamat, 300)
        && strOpt(request.resource.data.asalSekolah, 100)
        && strOpt(request.resource.data.catatan, 500)
        && request.resource.data.status == 'baru'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
